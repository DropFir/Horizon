{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "deepseek-v4-flash",
    "api_key_env": "DEEPSEEK_API_KEY",
    "base_url": "https://api.deepseek.com",
    "temperature": 0.3,
    "max_tokens": 8192,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "microsoft",
        "repo": "vscode",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "GitHub Blog",
        "url": "https://github.blog/feed/",
        "enabled": true,
        "category": "industry"
      },
      {
        "name": "Rust Blog",
        "url": "https://blog.rust-lang.org/feed.xml",
        "enabled": true,
        "category": "lang"
      },
      {
        "name": "Go Blog",
        "url": "https://go.dev/blog/feed.atom",
        "enabled": true,
        "category": "lang"
      },
      {
        "name": "Dan Luu",
        "url": "https://danluu.com/atom.xml",
        "enabled": true,
        "category": "systems"
      },
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "industry"
      },
      {
        "name": "阮一峰的网络日志",
        "url": "https://www.ruanyifeng.com/blog/atom.xml",
        "enabled": true,
        "category": "blog"
      },
      {
        "name": "LWN.net (subscriber full-text)",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": true,
        "category": "linux"
      }
    ],
    "reddit": {
      "enabled": true,
      "fetch_comments": 3,
      "subreddits": [
        {
          "subreddit": "programming",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 80
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 12,
          "min_score": 40
        }
      ],
      "users": []
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": true,
      "apify_token_env": "APIFY_TOKEN",
      "actor_id": "altimis~scweet",
      "users": ["pankajkumar_dev"],
      "fetch_limit": 10,
      "time_window_hours": 48,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 5,
      "reply_min_likes": 5
    },
    "openbb": {
      "enabled": false,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": [
        {
          "name": "megacaps",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 15,
          "category": "equities",
          "symbols": [
            "AAPL",
            "MSFT",
            "NVDA",
            "GOOGL",
            "AMZN",
            "META"
          ]
        }
      ]
    }
  },
  "filtering": {
    "ai_score_threshold": 7.5,
    "time_window_hours": 24
  },
  "webhook": {
    "enabled": true,
    "topics_url_env": "HORIZON_TOPICS_URL",
    "languages": ["zh"]
  }
}
